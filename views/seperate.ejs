<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <!-- Global CSS for header/footer -->
    <link rel="stylesheet" href="/global.css">

    <!-- Page-specific CSS -->
    <% if (typeof css !== 'undefined' && css.length) { %>
        <% css.forEach(function(file){ %>
            <link rel="stylesheet" href="<%= file %>">
        <% }) %>
    <% } %>
</head>
<body>
    <!-- Header -->
    <%- include('partials/header', { title }) %>

    <main class="horizontal-wrapper">
        <section class="seperate-text">
            <h1>Separation of frontend and backend</h1>
            <h3>Reasons to separate</h3>
            <p>What should you be able to see as an end user?</p>
            <p>Build a folder for the public use and folders for backend infrastructure.</p>
            <p class="clickable" id="renderQuestion">How do you render?</p>
        </section>

        <section class="seperate-image">
            <!-- Modal -->
            <div id="renderModal" class="modal">
                <div class="modal-content">
                    <span class="close">&times;</span>
                    <h3>How rendering works</h3>
                    <p>Rendering is sending data from the backend to the frontend.</p>
                    <p>If you don't render, the data is never shown on the frontend.</p>
                    <p>You should make separate connections for each use. Use DTOs if possible.</p>
                </div>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <%- include('partials/footer') %>

    <!-- Page-specific JS -->
    <% if (typeof scripts !== 'undefined' && scripts.length) { %>
        <% scripts.forEach(function(file){ %>
            <script src="<%= file %>"></script>
        <% }) %>
    <% } %>
</body>
</html>
