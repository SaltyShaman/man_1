<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <!-- Global CSS for header/footer -->
    <link rel="stylesheet" href="/global.css">

    <!-- Page-specific CSS -->
    <% if (typeof css !== 'undefined' && css.length) { %>
        <% css.forEach(function(file){ %>
            <link rel="stylesheet" href="<%= file %>">
        <% }) %>
    <% } %>
</head>
<body>
    <!-- Header -->
    <%- include('partials/header', { title: title }) %>

    <main>
        <section class="web-server">
            <h1>How to start a web server</h1>
            <h2>Please choose a topic:</h2>

            <h3>Terminal commands</h3>
            <button id="openModal">Show commands</button>

            <!-- Modal -->
            <div id="myModal" class="modal">
                <div class="modal-content">
                    <span class="close">&times;</span>
                    <h2>Terminal Commands</h2>
                    <pre>
# Start server — use nodemon for easier development
nodemon app.js (change app.js to your main file name)
    -> Make sure to get this installed for faster development
       npm install nodemon

# Basic setup:
npm install 
    -> This will install all dependencies
    -> You will also need it when working on fetched repos
                    </pre>
                </div>  
            </div>

            <h3>How to route</h3>
            <p>In your server file, remember to add an endpoint for every page:</p>
            <pre>
app.get('/', (req, res) => {
    res.sendFile(path.join(__dirname, 'public/pages/frontend/index.html'));
});
            </pre>
            <p>Pay attention to SEO if it’s important for your project.</p>

            <h3>How to make your project easy to maintain</h3>
            <p>Create a new folder for every entity.</p>
            <p>Place all related files for the entity in the same folder.</p>
        </section>
    </main>

    <!-- Footer -->
    <%- include('partials/footer') %>

    <!-- Page-specific JS -->
    <% if (typeof scripts !== 'undefined' && scripts.length) { %>
        <% scripts.forEach(function(file){ %>
            <script src="<%= file %>"></script>
        <% }) %>
    <% } %>
</body>
</html>
